---
layout: base.njk
---
<div class="ficha-wrap active" style="display:block;">
  <a class="back-link" href="/" style="text-decoration:none;">← Volver al índice</a>


  <div class="ficha-grid">
    <div class="ficha-photo-col">
      <div class="ficha-photo">
        <img src="/img/{{ numero }}-foto1.jpg" style="width:100%;height:100%;object-fit:cover;" alt="{{ numero }}"/>
      </div>
      <div class="ficha-photo-caption mono">
<span>FOT. {{ numero }} / 100 · S.S®</span>
</div>
</div>
<div class="ficha-content">
      <div class="ficha-number">{{ numero }}</div>
      <div class="ficha-cats">
        <div class="ficha-cats-left">
          <div class="cat-icon" title="{{ categoria }}">{{ icono | icon | safe }}</div>
        </div>
        <div class="ficha-author">
          <div class="author-avatar">{{ personas[autor].iniciales }}</div>
<span class="ficha-author-label">{{ personas[autor].cargo | upper }} — <strong>{{ personas[autor].nombre }}</strong></span></div>
      </div>
      <div class="ficha-title">{{ nombre }}</div>
      <div class="ficha-year mono">{{ origen }} — {{ anio }} — DISEÑO: {{ disenador }}</div>


      <div class="ficha-share">
        <span class="ficha-share-label mono">COMPARTIR</span>
        <span class="share-icon" title="Copiar enlace">{{ "link" | icon | safe }}</span>
        <span class="share-icon" title="Pinterest">{{ "push_pin" | icon | safe }}</span>
        <span class="share-icon" title="X (Twitter)">{{ "tag" | icon | safe }}</span>
      </div>


      <div class="ficha-block">
        <div class="ficha-block-label">Nota personal</div>
        <p class="ficha-intro">{{ notaPersonal }}</p>
      </div>


      <div class="ficha-block">
        <div class="ficha-block-label">Descripción</div>
        <p class="ficha-desc">{{ descripcion }}</p>
      </div>


      <div class="ficha-block">
        <div class="ficha-block-label">Dato curioso</div>
        <p class="ficha-desc">{{ datoCurioso }}</p>
      </div>


      <div class="ficha-block">
        <div class="ficha-block-label">Ficha técnica</div>
        <table class="spec-table">
          <tr><td>Año</td><td>{{ anio }}</td></tr>
          <tr><td>Material</td><td>{{ material }}</td></tr>
          <tr><td>Origen</td><td>{{ origen }}</td></tr>
          <tr><td>Estado</td><td><span class="status-tag {{ estado | estadoClass }}"><span class="status-dot"></span>{{ estadoLabel }}</span></td></tr>
          {% if datoExtra %}<tr><td>{{ datoExtraLabel }}</td><td>{{ datoExtra }}</td></tr>{% endif %}
        </table>
      </div>
    </div>
  </div>


  {% set idxActual = -1 %}
  {% for obj in collections.objetos %}{% if obj.data.numero == numero %}{% set idxActual = loop.index0 %}{% endif %}{% endfor %}
  {% set objAnterior = collections.objetos[idxActual - 1] if idxActual > 0 else null %}
  {% set objSiguiente = collections.objetos[idxActual + 1] if idxActual > -1 and idxActual < (collections.objetos.length - 1) else null %}
  <div class="ficha-nav">
    {% if objAnterior %}<a href="{{ objAnterior.url }}" style="color:inherit;text-decoration:none;">← {{ objAnterior.data.numero }} — ANTERIOR</a>{% else %}<span></span>{% endif %}
    <span class="mono">{{ numero }} / 100</span>
    {% if objSiguiente %}<a href="{{ objSiguiente.url }}" style="color:inherit;text-decoration:none;">{{ objSiguiente.data.numero }} — SIGUIENTE →</a>{% else %}<span></span>{% endif %}
  </div>
div>

</
